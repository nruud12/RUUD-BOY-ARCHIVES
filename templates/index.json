/*
 * ------------------------------------------------------------
 * RUUD BOY ARCHIVES — HOMEPAGE
 *
 * Two movements now, not three:
 *
 *   1. room_title     a wall caption
 *   2. recently_*     the catalogue wall
 *
 * Sanctum Environment: the standalone `hero` entry (type
 * archive-sanctum — full-viewport, with its own tagline/artifact
 * label/CTA) has been retired. The Sanctum is now a persistent,
 * sitewide environmental background (snippets/archive-sanctum-
 * environment.liquid, rendered once from layout/theme.liquid)
 * rather than a per-template hero, so this template no longer
 * needs its own entry for it — the room is already behind this
 * page, the same as every other page. sections/archive-sanctum.
 * liquid (the old hero section + its CTA) remains in the theme,
 * unreferenced, the same way archive-hero-v2 was retired before
 * it — reversible by restoring this entry.
 *
 * archive-hero-v2's section, CSS and JS remain unreferenced, as
 * before. The persistent transport deck (snippets/archive-
 * player.liquid, rendered sitewide in layout/theme.liquid) is
 * untouched by any of this.
 *
 * The previous composition still carried the inherited Savor
 * demo content (a food-brand story section, a lime-green
 * #39ff14 product grid, magenta price labels). All of it has
 * been removed — see ARCHIVE-REDESIGN.md.
 *
 * Card captions are no longer built from theme blocks. The
 * gallery block is the only child; archive number, title and
 * metadata are rendered by snippets/product-card.liquid from
 * the `custom` metafield namespace.
 * ------------------------------------------------------------
 */
{
  "sections": {
    "room_title": {
      "type": "archive-room-title",
      "settings": {
        "eyebrow": "The Holdings",
        "title": "Recently catalogued",
        "link_label": "Enter the reading room",
        "link": "shopify://collections/all"
      }
    },
    "recently_catalogued": {
      "type": "product-list",
      "blocks": {
        "static-header": {
          "type": "_product-list-content",
          "static": true,
          "settings": {
            "content_direction": "column",
            "vertical_on_mobile": true,
            "horizontal_alignment": "flex-start",
            "vertical_alignment": "center",
            "align_baseline": false,
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "center",
            "gap": 0,
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "custom_height": 100,
            "background_media": "none",
            "background_color": "",
            "video_position": "cover",
            "background_image_position": "cover",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_color": "",
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "static-product-card": {
          "type": "_product-card",
          "name": "t:names.product_card",
          "static": true,
          "settings": {
            "product_card_gap": 0,
            "background_color": "",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_color": "",
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "card_gallery": {
              "type": "_product-card-gallery",
              "name": "t:names.product_card_media",
              "settings": {
                "image_ratio": "square",
                "border": "none",
                "border_width": 0,
                "border_opacity": 0,
                "border_color": "",
                "border_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            }
          },
          "block_order": ["card_gallery"]
        }
      },
      "name": "t:names.product_list",
      "settings": {
        "collection": "all",
        "layout_type": "grid",
        "carousel_on_mobile": false,
        "max_products": 8,
        "columns": 4,
        "mobile_columns": "2",
        "mobile_card_size": "60cqw",
        "columns_gap": 24,
        "rows_gap": 48,
        "icons_style": "arrow",
        "icons_shape": "none",
        "section_width": "page-width",
        "horizontal_alignment": "flex-start",
        "gap": 0,
        "background_color": "rgba(5, 5, 5, 0.2)",
        "padding-block-start": 0,
        "padding-block-end": 96
      }
    }
  },
  "order": ["room_title", "recently_catalogued"]
}
