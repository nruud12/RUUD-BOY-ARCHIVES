/*
 * ------------------------------------------------------------
 * RUUD BOY ARCHIVES — HOMEPAGE
 *
 * Three movements, nothing more:
 *
 *   1. hero           the Preservation Sanctum, full viewport
 *   2. room_title     a wall caption
 *   3. recently_*     the catalogue wall
 *
 * Sanctum Hero: `hero` (archive-hero-v2, the Hero Player) has been
 * replaced by the Sanctum (archive-sanctum) as the site's master
 * first-viewport environment. Only one may occupy the "hero" slot.
 * archive-hero-v2's section, CSS and JS all remain in the theme,
 * unreferenced by this template, and the persistent transport deck
 * (snippets/archive-player.liquid, rendered sitewide in
 * layout/theme.liquid) is untouched — the swap is reversible by
 * restoring the entry this replaced.
 *
 * The previous composition still carried the inherited Savor
 * demo content (a food-brand story section, a lime-green
 * #39ff14 product grid, magenta price labels). All of it has
 * been removed — see ARCHIVE-REDESIGN.md.
 *
 * Card captions are no longer built from theme blocks. The
 * gallery block is the only child; archive number, title and
 * metadata are rendered by snippets/product-card.liquid from
 * the `custom` metafield namespace.
 * ------------------------------------------------------------
 */
{
  "sections": {
    "hero": {
      "type": "archive-sanctum",
      "settings": {
        "tagline": "PRESERVE. HONOR. SHARE.",
        "artifact_label": "RB-001",
        "cta_label": "ENTER ARCHIVE",
        "cta_link": "/collections/all"
      }
    },
    "room_title": {
      "type": "archive-room-title",
      "settings": {
        "eyebrow": "The Holdings",
        "title": "Recently catalogued",
        "link_label": "Enter the reading room",
        "link": "shopify://collections/all"
      }
    },
    "recently_catalogued": {
      "type": "product-list",
      "blocks": {
        "static-header": {
          "type": "_product-list-content",
          "static": true,
          "settings": {
            "content_direction": "column",
            "vertical_on_mobile": true,
            "horizontal_alignment": "flex-start",
            "vertical_alignment": "center",
            "align_baseline": false,
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "center",
            "gap": 0,
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "custom_height": 100,
            "background_media": "none",
            "background_color": "",
            "video_position": "cover",
            "background_image_position": "cover",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_color": "",
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "static-product-card": {
          "type": "_product-card",
          "name": "t:names.product_card",
          "static": true,
          "settings": {
            "product_card_gap": 0,
            "background_color": "",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_color": "",
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "card_gallery": {
              "type": "_product-card-gallery",
              "name": "t:names.product_card_media",
              "settings": {
                "image_ratio": "square",
                "border": "none",
                "border_width": 0,
                "border_opacity": 0,
                "border_color": "",
                "border_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            }
          },
          "block_order": ["card_gallery"]
        }
      },
      "name": "t:names.product_list",
      "settings": {
        "collection": "all",
        "layout_type": "grid",
        "carousel_on_mobile": false,
        "max_products": 8,
        "columns": 4,
        "mobile_columns": "2",
        "mobile_card_size": "60cqw",
        "columns_gap": 24,
        "rows_gap": 48,
        "icons_style": "arrow",
        "icons_shape": "none",
        "section_width": "page-width",
        "horizontal_alignment": "flex-start",
        "gap": 0,
        "background_color": "",
        "padding-block-start": 0,
        "padding-block-end": 96
      }
    }
  },
  "order": ["hero", "room_title", "recently_catalogued"]
}
