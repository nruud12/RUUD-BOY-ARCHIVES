<div id="archive-player" class="archive-player">

  <div class="archive-player__left">

    <img
      class="archive-player__artwork"
      data-player-artwork
      src=""
      alt="Album artwork"
    >

    <div class="archive-player__meta">

      <h2
        class="archive-player__title"
        data-player-title>
        Nothing Playing
      </h2>

      <div class="archive-player__catalog">

        <span
          class="archive-player__archive"
          data-player-archive>
          ARCH ----
        </span>

      </div>

      <div class="archive-player__details">

        <span data-player-bpm>---</span>
        <span>BPM</span>

        <span class="separator">•</span>

        <span data-player-key>--</span>

        <span class="separator">•</span>

        <span data-player-mood>---</span>

      </div>

    </div>

  </div>

  <div class="archive-player__center">

    <button
      class="archive-player__play"
      data-player-play
      aria-label="Play Preview">

      ▶

    </button>

    <input
      type="range"
      min="0"
      max="100"
      value="0"
      class="archive-player__progress"
      data-player-progress
    >

  </div>

  <div class="archive-player__right">

    <span
      class="archive-player__time"
      data-player-time>

      0:00 / 0:00

    </span>

  </div>

</div>