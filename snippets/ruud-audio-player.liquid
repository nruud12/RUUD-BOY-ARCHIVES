{% if product.metafields.custom.audio_preview.value != blank %}

<div
  class="ruud-player"
  data-rc1="YES"
  data-product-id="{{ product.id }}"
  data-title="{{ product.title | escape }}"
  data-audio="{{ product.metafields.custom.audio_preview.value.url }}"
  data-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 240 }}{% endif %}"
  data-product-url="{{ product.url }}"
  data-bpm="{{ product.metafields.custom.bpm }}"
  data-key="{{ product.metafields.custom.key }}"
  data-mood="{{ product.metafields.custom.mood }}"
  data-type="{{ product.metafields.custom.type }}"
  data-variants='{{ product.variants | json | escape }}'
>

    <button class="ruud-play-button" type="button">

    <span class="ruud-play-icon">
        ▶
    </span>

    <span class="ruud-play-label">
        Preview
    </span>

</button>

<div class="archive-card-footer">

    4 LICENSE OPTIONS AVAILABLE

</div>

</div>

{% endif %}

